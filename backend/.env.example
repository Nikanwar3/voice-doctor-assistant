# Google Gemini — LLM. Free tier key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ElevenLabs — used for both STT and TTS. Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice used for the agent's speech. Default is ElevenLabs' public "Rachel" voice.
# Swap for any voice_id from your ElevenLabs Voice Library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Local server
HOST=localhost
PORT=7860
